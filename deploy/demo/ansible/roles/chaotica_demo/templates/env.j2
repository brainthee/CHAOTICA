# {{ ansible_managed }}
# Rendered from deploy/demo/ansible/group_vars/all.yml. Read by docker compose
# (variable interpolation + the web service's env_file) and by reset_demo.sh.

# --- Image -----------------------------------------------------------------
CHAOTICA_IMAGE='{{ chaotica_image }}'

# --- App behaviour (same image as prod; these are the only differences) -----
DEBUG=0
DJANGO_ENV='Demo'
DJANGO_VERSION='latest'
SECRET_KEY='{{ demo_secret_key }}'
TZ='{{ demo_timezone }}'
SITE_DOMAIN='{{ demo_domain }}'
SITE_PROTO='https'
DJANGO_ALLOWED_HOSTS='{{ demo_domain }} localhost 127.0.0.1 web'
CSRF_TRUSTED_ORIGINS='https://{{ demo_domain }}'
HEALTH_CHECK_API_KEY='{{ demo_health_check_api_key }}'
MAXMIND_LICENSE_KEY='{{ maxmind_license_key }}'

# Demo mode: login-page banner with countdown + pre-filled credentials.
DEMO_ENV=true
DEMO_USER='{{ demo_user }}'
DEMO_PASS='{{ demo_pass }}'
DEMO_RESET_TIME='{{ demo_reset_time }}'

# --- Database ----------------------------------------------------------------
RDS_PASSWORD='{{ demo_db_password }}'
MARIADB_ROOT_PASSWORD='{{ demo_db_root_password }}'

# --- Nightly reset (reset_demo.sh) -------------------------------------------
DEMO_USER_PASSWORD='{{ demo_user_password }}'
DEMO_SEED_USERS={{ demo_seed_users }}
DEMO_SEED_CLIENTS={{ demo_seed_clients }}
DEMO_SEED_JOBS={{ demo_seed_jobs }}
